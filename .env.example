# MediSecure local development — copy to .env and adjust as needed.
# Never commit real secrets. Designed for future K8s Secrets / Vault injection.

POSTGRES_USER=medisecure
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=medisecure
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://medisecure:change_me_local_only@db:5432/medisecure

# JWT — use a long random value in any shared environment
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth throttling
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
APP_NAME=MediSecure
APP_ENV=development
SEED_DEMO_DATA=true

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# MediSecure environment template — copy to `.env` and adjust.
# Never commit real secrets. Designed for Compose / future K8s Secrets injection.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=MediSecure
# development | production
APP_ENV=production
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=medisecure
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=medisecure
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-published ports (docker-compose.dev.yml only)
POSTGRES_HOST_PORT=5432

# SQLAlchemy URL (Compose overrides host to `db` for containers)
DATABASE_URL=postgresql+psycopg://medisecure:change_me_local_only@localhost:5432/medisecure

# ---------------------------------------------------------------------------
# JWT — replace with a long random value before any shared use
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=dev-only-change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Auth throttling
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# CORS — comma-separated browser origins
# Compose demo frontend is http://localhost:8080
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Host port mappings (Compose)
# ---------------------------------------------------------------------------
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Frontend (Vite build arg / local npm run dev)
# Compose production build should use same-origin Nginx proxy:
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

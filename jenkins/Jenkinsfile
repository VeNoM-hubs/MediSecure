pipeline {
  agent any

  parameters {
    string(name: 'REGISTRY', defaultValue: '', description: 'Container registry host (optional)')
    string(name: 'IMAGE_NAMESPACE', defaultValue: 'medisecure', description: 'Image namespace/repo prefix')
    string(name: 'KUBE_NAMESPACE', defaultValue: 'medisecure', description: 'Target Kubernetes namespace')
    choice(name: 'TRIVY_SEVERITY', choices: ['HIGH,CRITICAL', 'CRITICAL', 'MEDIUM,HIGH,CRITICAL'], description: 'Fail severity')
    booleanParam(name: 'PUSH_IMAGES', defaultValue: false, description: 'Push images when registry is configured')
    booleanParam(name: 'DEPLOY_K8S', defaultValue: false, description: 'Apply Kubernetes manifests')
  }

  environment {
    BACKEND_IMAGE = "${params.IMAGE_NAMESPACE}/backend:${env.BUILD_NUMBER}"
    FRONTEND_IMAGE = "${params.IMAGE_NAMESPACE}/frontend:${env.BUILD_NUMBER}"
    TRIVY_IGNOREFILE = '/dev/null'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Backend unit tests') {
      steps {
        dir('backend') {
          sh '''
            python -m venv .venv
            . .venv/bin/activate
            pip install -r requirements.txt
            pytest -q
          '''
        }
      }
    }

    stage('Frontend unit tests') {
      steps {
        dir('frontend') {
          sh 'npm ci && npm test && npm run build'
        }
      }
    }

    stage('SonarQube analysis') {
      when { expression { return env.SONAR_HOST_URL?.trim() } }
      steps {
        withSonarQubeEnv('SonarQube') {
          sh 'sonar-scanner -Dproject.settings=sonar-project.properties'
        }
      }
    }

    stage('Trivy filesystem scan') {
      steps {
        sh '''
          mkdir -p reports
          trivy fs --config "" --ignorefile "$TRIVY_IGNOREFILE" \
            --severity "$TRIVY_SEVERITY" --exit-code 1 \
            --format json --output reports/trivy-fs.json .
          trivy fs --config "" --ignorefile "$TRIVY_IGNOREFILE" \
            --severity "$TRIVY_SEVERITY" --exit-code 1 \
            --format table --output reports/trivy-fs.txt .
        '''
      }
    }

    stage('Docker build') {
      steps {
        sh '''
          docker build -t ${BACKEND_IMAGE} ./backend
          docker build -t ${FRONTEND_IMAGE} ./frontend
        '''
      }
    }

    stage('Trivy image scan') {
      steps {
        sh '''
          trivy image --config "" --ignorefile "$TRIVY_IGNOREFILE" \
            --severity "$TRIVY_SEVERITY" --exit-code 1 \
            --format json --output reports/trivy-backend.json ${BACKEND_IMAGE}
          trivy image --config "" --ignorefile "$TRIVY_IGNOREFILE" \
            --severity "$TRIVY_SEVERITY" --exit-code 1 \
            --format json --output reports/trivy-frontend.json ${FRONTEND_IMAGE}
        '''
      }
    }

    stage('Push images') {
      when {
        allOf {
          expression { return params.PUSH_IMAGES }
          expression { return params.REGISTRY?.trim() }
        }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-credentials', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh '''
            echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
            docker tag ${BACKEND_IMAGE} ${REGISTRY}/${BACKEND_IMAGE}
            docker tag ${FRONTEND_IMAGE} ${REGISTRY}/${FRONTEND_IMAGE}
            docker push ${REGISTRY}/${BACKEND_IMAGE}
            docker push ${REGISTRY}/${FRONTEND_IMAGE}
          '''
        }
      }
    }

    stage('Deploy Kubernetes') {
      when { expression { return params.DEPLOY_K8S } }
      steps {
        withCredentials([file(credentialsId: 'kubeconfig-medisecure', variable: 'KUBECONFIG')]) {
          sh '''
            kubectl apply -f k8s/config/namespace.yaml
            kubectl apply -f k8s/security/
            kubectl apply -f k8s/database/ --namespace ${KUBE_NAMESPACE} || true
            kubectl apply -f k8s/backend/ --namespace ${KUBE_NAMESPACE}
            kubectl apply -f k8s/frontend/ --namespace ${KUBE_NAMESPACE}
            kubectl rollout status deployment/medisecure-backend -n ${KUBE_NAMESPACE}
            kubectl rollout status deployment/medisecure-frontend -n ${KUBE_NAMESPACE}
          '''
        }
      }
    }

    stage('Smoke tests') {
      when { expression { return params.DEPLOY_K8S } }
      steps {
        sh '''
          kubectl -n ${KUBE_NAMESPACE} get pods
          # Placeholder smoke check — replace with ingress URL via credentials/config later
          echo "Smoke stage ready for configured ingress health probes"
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
    }
  }
}
